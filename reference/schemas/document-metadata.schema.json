{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aosdf.dev/schemas/document-metadata/v1",
  "title": "AOSDF document metadata v1",
  "type": "object",
  "required": [
    "title",
    "type",
    "tags",
    "created",
    "updated",
    "sources",
    "document_schema",
    "id",
    "summary",
    "entities"
  ],
  "properties": {
    "document_schema": {
      "const": "aosdf-doc/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "updated": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "metadata_updated": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "metadata_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
