9:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","div",null,{"className":"learn_shell__7Psru","children":[["$","header",null,{"className":"learn_header__7Ct4g","children":[["$","$Lc",null,{"href":"/","children":"◼ AOSDF"}],["$","$Lc",null,{"href":"/learn","children":"Learning"}]]}],["$","main",null,{"className":"learn_home__Hi7kO","children":[["$","p",null,{"className":"learn_eyebrow__swK9W","children":"AI-orchestrated software development"}],["$","h1",null,{"children":"The foundations of a software factory"}],["$","p",null,{"className":"learn_lead__tuMX4","children":"AOSDF turns requirements and architecture into traceable execution plans. Specialized agents coordinate through explicit ownership, durable handoffs, risk-based review and evidence-based validation."}],["$","h2",null,{"children":"Use the public framework"}],["$","p",null,{"children":"The open-source project includes specifications, agent roles, project templates, coordination protocols and inactive automation, MCP and VS Code integrations, documentation tooling, and learning content."}],["$","p",null,{"children":["$","a",null,{"href":"https://github.com/mvsingh07/AOSDF","children":"Browse the source and setup guide"}]}],["$","h2",null,{"children":"Coordinate development threads"}],["$","p",null,{"children":"A Solution Architect maintains the execution plan. Coordinators manage thread ownership and handoffs. Workers implement bounded tasks, while review and validation scale with risk. Accepted results are reconciled without redispatching completed work. Each adopting project owns its configuration and runtime records."}],["$","h2",null,{"children":"Understand the current boundary"}],["$","p",null,{"children":"Reusable automation is inactive by default. AOSDF does not yet claim proven fully autonomous specification-to-production delivery. Repeatable releases across independent applications, measured human intervention, build reproducibility and recovery evidence remain the next factory milestones."}],["$","h2",null,{"children":"Managed hosting is a separate service"}],["$","p",null,{"children":"The privately operated companion application provides GitHub-connected documentation builds, deployment, authenticated access and role-based sharing. Its service code and customer records remain separate from this public repository."}],"$Ld"]}]]}],["$Le"],"$Lf"]}],"p":"$@10","v":null,"s":"$5"}}]]
