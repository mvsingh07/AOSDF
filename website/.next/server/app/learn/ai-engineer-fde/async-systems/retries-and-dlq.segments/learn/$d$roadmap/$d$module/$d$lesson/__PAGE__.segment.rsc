24:["$","details","pre-0",{"className":"docs_textDiagram__KfHuf","children":[["$","summary",null,{"children":"Read the text version of this flow"}],["$","pre",null,{"children":["$","code","code-0",{"className":"language-aosdf-diagram","children":"Claim job ──▶ call file store ──▶ success ──▶ persist result ──▶ acknowledge\n                    │\n                    ├── transient ──▶ backoff + jitter ──▶ retry\n                    └── permanent / exhausted ──▶ DLQ + failed status + alert\n"}]}]]}]
