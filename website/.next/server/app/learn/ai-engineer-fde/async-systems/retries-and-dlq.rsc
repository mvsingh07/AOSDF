1f:["$","figure","p-5",{"className":"docs_studyFigure__4Js_y","children":[["$","div",null,{"className":"docs_studyFigureViewport__ZYDNN","children":["$","img","img-0",{"className":"docs_studyFigureImage__Gb2YJ","src":"/learning/async-systems/retries.svg","alt":"A claimed job calls a dependency; success persists a result, while repeated failure moves through retry to a dead-letter queue and reviewed replay.","width":"920","height":"402","loading":"lazy"}]}],["$","figcaption",null,{"children":"A claimed job calls a dependency; success persists a result, while repeated failure moves through retry to a dead-letter queue and reviewed replay."}]]}]
20:["$","details","pre-0",{"className":"docs_textDiagram__KfHuf","children":[["$","summary",null,{"children":"Read the text version of this flow"}],["$","pre",null,{"children":["$","code","code-0",{"className":"language-aosdf-diagram","children":"Claim job ──▶ call file store ──▶ success ──▶ persist result ──▶ acknowledge\n                    │\n                    ├── transient ──▶ backoff + jitter ──▶ retry\n                    └── permanent / exhausted ──▶ DLQ + failed status + alert\n"}]}]]}]
21:["$","p","p-6",{"children":[["$","$L18","a-0",{"href":"/queue-delivery-lifecycle.archify.html","children":"Explore the full queue delivery diagram"}]," for the retry and quarantine branch."]}]
