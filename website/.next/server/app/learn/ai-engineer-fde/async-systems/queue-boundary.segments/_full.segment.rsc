21:["$","figure","p-5",{"className":"docs_studyFigure__4Js_y","children":[["$","div",null,{"className":"docs_studyFigureViewport__ZYDNN","children":["$","img","img-0",{"className":"docs_studyFigureImage__Gb2YJ","src":"/learning/async-systems/acceptance.svg","alt":"The API durably records an operation and returns an ID; a queue then delivers work to a worker that records the finished result.","width":"920","height":"402","loading":"lazy"}]}],["$","figcaption",null,{"children":"The API durably records an operation and returns an ID; a queue then delivers work to a worker that records the finished result."}]]}]
22:["$","details","pre-1",{"className":"docs_textDiagram__KfHuf","children":[["$","summary",null,{"children":"Read the text version of this flow"}],["$","pre",null,{"children":["$","code","code-0",{"className":"language-aosdf-diagram","children":"POST /exports ──▶ commit operation + intent ──▶ 202 + operation ID\n                         │\n                         └──▶ queue ──▶ worker ──▶ file ──▶ status: succeeded\n                                            └──▶ failure ──▶ status: failed / retrying\n"}]}]]}]
