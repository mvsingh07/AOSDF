th=device-width, initial-scale=1"}]]}],["$","$L1b",null,{"children":[["$","div",null,{"hidden":true,"children":["$","$1c",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Queues and reliable delivery · AI Engineer / FDE"}],["$","meta","1",{"name":"description","content":"Start with what a queue is and when to use one, then design work that survives retries, duplicates, overload, and partial failure."}]]}]}],null]}],null]}],"p":"$@1d","v":null,"s":"$5"}},"a":"$@1e","u":"$@1f","b":"NfOsFHPev3WyF2vd53cxj"}
