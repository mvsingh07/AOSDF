","td","td-0",{"children":"6"}],["$","td","td-1",{"children":["$","$L11","a-0",{"href":"/learn/ai-engineer-fde/async-systems/events-and-sagas","children":"Events, outbox, and sagas"}]}],["$","td","td-2",{"children":"How do services publish facts and coordinate partial work?"}]]}],["$","tr","tr-6",{"children":[["$","td","td-0",{"children":"7"}],["$","td","td-1",{"children":["$","$L11","a-0",{"href":"/learn/ai-engineer-fde/async-systems/delivery-channels","children":"Webhooks, live updates, and scheduled jobs"}]}],["$","td","td-2",{"children":"Which channel fits a recipient or timing need?"}]]}],["$","tr","tr-7",{"children":[["$","td","td-0",{"children":"8"}],["$","td","td-1",{"children":["$","$L11","a-0",{"href":"/learn/ai-engineer-fde/async-systems/operations","children":"Operating and reviewing a delivery system"}]}],["$","td","td-2",{"children":"How do we know work is moving and recover it safely?"}]]}]]}]]}],"\n",["$","h2","h2-1",{"id":"completion-check","children":"Completion check"}],"\n",["$","p","p-0",{"children":"Explain one export request from acceptance through a successful result, a duplicate delivery, an unavailable file store, and a poison job. Name the durable record, acknowledgement point, effect deduplication rule, queue-age alert, and manual replay procedure. If one is undefined, the architecture is not ready to rely on."}],"\n",["$","h2","h2-2",{"id":"primary-references","children":"Primary references"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["$","a","a-0",{"href":"https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/standard-queues.html","target":"_blank","rel":"noopener noreferrer","children":"Amazon SQS standard queue semantics"}]}],"\n",["$","li","li-1",{"children":["$","a","a-0",{"href":"https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/sqs-visibility-timeout.html","target":"_blank","rel":"noopener noreferrer","children":"Amazon SQS visibility timeout"}]}],"\n",["$",