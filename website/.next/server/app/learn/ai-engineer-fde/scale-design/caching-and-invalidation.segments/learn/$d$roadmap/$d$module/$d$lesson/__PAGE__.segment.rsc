25:["$","p","p-5",{"children":["Cloudflare Cache can keep public versioned assets at the edge. Redis can hold bounded application cache entries. NGINX can honor or generate HTTP cache headers at a controlled proxy boundary. The important engineering decision is the ",["$","strong","strong-0",{"children":"cacheability rule"}],", not which logo sits on the architecture diagram."]}]
26:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"style":{"textAlign":"center"},"children":"Logo"}],["$","th","th-1",{"children":"Technology and documentation"}],["$","th","th-2",{"children":"Role in this design"}],["$","th","th-3",{"children":"Check before adopting"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-cloudflare.svg","alt":"cloudflare logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://developers.cloudflare.com/cache/get-started/","target":"_blank","rel":"noopener noreferrer","children":"Cloudflare Cache"}]}],["$","td","td-2",{"children":"Serve public immutable thumbnails and assets near readers."}],["$","td","td-3",{"children":"Bypass shared caching for private document responses."}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-redis.svg","alt":"redis logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://redis.io/docs/latest/develop/use-cases/cache-aside/","target":"_blank","rel":"noopener noreferrer","children":"Redis"}]}],["$","td","td-2",{"children":"Store short-lived metadata or versioned derived results."}],["$","td","td-3",{"children":"Include tenant, permission scope, and version in keys."}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-nginx.svg","alt":"nginx logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://nginx.org/en/docs/http/ngx_http_proxy_module.html","target":"_blank","rel":"noopener noreferrer","children":"NGINX proxy cache"}]}],["$","td","td-2",{"children":"Control a proxy cache in self-hosted deployments."}],["$","td","td-3",{"children":"Audit headers, cookie handling, and invalidation."}]]}]]}]]}]
27:["$","p","p-6",{"children":["For a fingerprinted public asset, an origin might send ",["$","code","code-0",{"children":"Cache-Control: public, max-age=31536000, immutable"}],". For a private document body, use ",["$","code","code-1",{"children":"Cache-Control: private, no-store"}]," unless you have a reviewed private-cache contract. A Redis key like ",["$","code","code-2",{"children":"doc:{tenant}:{id}:v{version}"}]," avoids returning v7 as v8; permission-scoped results also need the viewer's authorization scope. Test permission revocation and cache outage explicitly before calling the path complete."]}]
