27:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":["$","a","a-0",{"href":"https://www.postgresql.org/docs/current/using-explain.html","target":"_blank","rel":"noopener noreferrer","children":"PostgreSQL: using EXPLAIN"}]}],"\n",["$","li","li-1",{"children":["$","a","a-0",{"href":"https://www.postgresql.org/docs/current/sql-createindex.html","target":"_blank","rel":"noopener noreferrer","children":"PostgreSQL: CREATE INDEX"}]}],"\n",["$","li","li-2",{"children":["$","a","a-0",{"href":"https://www.postgresql.org/docs/current/runtime-config-resource.html","target":"_blank","rel":"noopener noreferrer","children":"PostgreSQL: resource consumption and connections"}]}],"\n"]}]
