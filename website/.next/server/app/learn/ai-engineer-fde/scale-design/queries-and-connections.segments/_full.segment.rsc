d-connections","aria-current":"page","className":"docs_current__kaxcu","children":[["$","span",null,{"children":"06"}],"Queries, indexes, and connections"]}],["$","$L18","replication-and-sharding",{"href":"/learn/ai-engineer-fde/scale-design/replication-and-sharding","aria-current":"$undefined","className":"","children":[["$","span",null,{"children":"07"}],"Replication, partitioning, and sharding"]}],["$","$L18","consistency-and-time",{"href":"/learn/ai-engineer-fde/scale-design/consistency-and-time","aria-current":"$undefined","className":"","children":[["$","span",null,{"children":"08"}],"Consistency, partitions, and time"]}],["$","$L18","concurrency-and-runtime",{"href":"/learn/ai-engineer-fde/scale-design/concurrency-and-runtime","aria-current":"$undefined","className":"","children":[["$","span",null,{"children":"09"}],"Concurrency, locks, and runtime health"]}],["$","$L18","compatibility-and-review",{"href":"/learn/ai-engineer-fde/scale-design/compatibility-and-review","aria-current":"$undefined","className":"","children":[["$","span",null,{"children":"10"}],"Compatible change and architecture review"]}]]]}]]}],"toc":["$","aside",null,{"className":"docs_toc__B_lbZ","aria-label":"On this page","children":[["$","strong",null,{"children":"ON THIS PAGE"}],[["$","a","follow-the-query-plan",{"href":"#follow-the-query-plan","children":"Follow the query plan"}],["$","a","budget-connections-not-only-cpus",{"href":"#budget-connections-not-only-cpus","children":"Budget connections, not only CPUs"}],["$","a","diagram-a-bounded-data-path",{"href":"#diagram-a-bounded-data-path","children":"Diagram: a bounded data path"}],["$","a","implementation-inspect-the-database-before-enlarging-it",{"href":"#implementation-inspect-the-database-before-enlarging-it","children":"Implementation: inspect the database before enlarging it"}],["$","a","engineering-exercise",{"href":"#engineering-exercise","children":"Engineering exercise"}],["$","a","design-review-questions",{"href":"#design-re