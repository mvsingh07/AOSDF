26:["$","p","p-5",{"children":"NGINX can distribute HTTP traffic; Kubernetes can manage replicas, readiness, and horizontal autoscaling; Prometheus can expose the saturation that tells you whether scaling helped. A managed load balancer can play the ingress role in another environment. None of these tools removes the shared database limit."}]
27:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"style":{"textAlign":"center"},"children":"Logo"}],["$","th","th-1",{"children":"Technology and documentation"}],["$","th","th-2",{"children":"Role in this design"}],["$","th","th-3",{"children":"Check before adopting"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-nginx.svg","alt":"nginx logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://nginx.org/en/docs/http/load_balancing.html","target":"_blank","rel":"noopener noreferrer","children":"NGINX load balancing"}]}],["$","td","td-2",{"children":"Route requests across API instances."}],["$","td","td-3",{"children":"Configure upstream failure behavior and request timeouts."}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-kubernetes.svg","alt":"kubernetes logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://kubernetes.io/docs/concepts/workloads/autoscaling/","target":"_blank","rel":"noopener noreferrer","children":"Kubernetes HPA"}]}],["$","td","td-2",{"children":"Adjust replica count from a measured workload signal."}],["$","td","td-3",{"children":"Provide resource requests, readiness, and scale-down behavior."}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-prometheus.svg","alt":"prometheus logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://prometheus.io/docs/introduction/overview/","target":"_blank","rel":"noopener noreferrer","children":"Prometheus"}]}],["$","td","td-2",{"children":"Track API saturation, database connections, and errors."}],["$","td","td-3",{"children":"Confirm the bottleneck moved after scaling."}]]}]]}]]}]
28:["$","p","p-6",{"children":"A small NGINX upstream for two interchangeable instances looks like this; production deployments also need TLS, readiness, and graceful draining:"}]
29:["$","pre","pre-1",{"children":["$","code","code-0",{"className":"language-nginx","children":"upstream document_api {\n    server api-a:8080;\n    server api-b:8080;\n}\nserver {\n    listen 80;\n    location / { proxy_pass http://document_api; }\n}\n"}]}]
2a:["$","p","p-7",{"children":"Set an aggregate database connection budget before raising the HPA maximum. For example, 20 replicas × 12 connections = 240 potential API connections. If the database can safely support only 200 after reserves, the autoscaling policy and pool settings disagree."}]
