18:["$","aside",null,{"className":"docs_toc__B_lbZ","aria-label":"On this page","children":[["$","strong",null,{"children":"ON THIS PAGE"}],[["$","a","begin-with-behavior-not-boxes",{"href":"#begin-with-behavior-not-boxes","children":"Begin with behavior, not boxes"}],["$","a","diagram-one-request-before-scale",{"href":"#diagram-one-request-before-scale","children":"Diagram: one request before scale"}],["$","a","worked-design-decision",{"href":"#worked-design-decision","children":"Worked design decision"}],["$","a","implementation-a-credible-first-stack",{"href":"#implementation-a-credible-first-stack","children":"Implementation: a credible first stack"}],["$","a","engineering-exercise",{"href":"#engineering-exercise","children":"Engineering exercise"}],["$","a","design-review-questions",{"href":"#design-review-questions","children":"Design review questions"}],["$","a","read-further",{"href":"#read-further","children":"Read further"}]]]}]
19:["$","main",null,{"className":"docs_main__7o2m6","children":[["$","div",null,{"className":"docs_articleMeta__8zYHO","children":[["$","span",null,{"children":"LESSON 01 OF 10"}],["$","span",null,{"children":"Systems"}]]}],["$","article",null,{"className":"docs_article__Ja_Vh","children":[["$","$1","0",{"children":[[["$","h1","h1-0",{"children":"What system design solves"}],"\n",["$","p","p-0",{"children":["A system is the people-facing behavior plus the software and data paths that produce it. ",["$","strong","strong-0",{"children":"System design"}]," asks how those parts will meet a promise under ordinary traffic, failure, and change. A diagram is useful only when its arrows have a contract: who sends what, where truth is stored, and what happens if a box is unavailable."]}],"\n",["$","h2","h2-0",{"id":"begin-with-behavior-not-boxes","children":"Begin with behavior, not boxes"}],"\n",["$","p","p-1",{"children":["Our document library has three actions: open a document, save an edit, and search documents the user may access. Begin with one API and one relational database. Store a document ID, owner, access rule, title, version, and object-storage key in the database; keep larger document bodies in object storage. On a read, authorize the user ",["$","strong","strong-0",{"children":"before"}]," returning a body or a cached result. On a save, update the document version atomically and return the new version."]}],"\n",["$","p","p-2",{"children":["Write two kinds of requirement. ",["$","strong","strong-0",{"children":"Functional"}],": an editor can save a document and another authorized reader can open it. ",["$","strong","strong-1",{"children":"Quality"}],": for example, 99% of authorized document opens finish within 400 ms, and a successful save is visible to that editor immediately. Define what a failed save looks like; a timeout does not prove that no write occurred. A service level objective (SLO) measures an observable promise, whereas a server specification is only one means to meet it."]}],"\n",["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Concern"}],["$","th","th-1",{"children":"Example question"}],["$","th","th-2",{"children":"Initial answer"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"Users"}],["$","td","td-1",{"children":"Who can read and edit?"}],["$","td","td-2",{"children":"Owner and granted collaborators"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"Correctness"}],["$","td","td-1",{"children":"Can edits overwrite each other?"}],["$","td","td-2",{"children":"Compare the submitted version"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"Speed"}],["$","td","td-1",{"children":"Which action matters most?"}],["$","td","td-2",{"children":"Document open p99 under 400 ms"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"Durability"}],["$","td","td-1",{"children":"What must survive a crash?"}],["$","td","td-2",{"children":"A confirmed edit and its version"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"Failure"}],["$","td","td-1",{"children":"Can a read be stale?"}],["$","td","td-2",{"children":"Listing may lag; own edit may not"}]]}]]}]]}],"\n",["$","h2","h2-1",{"id":"diagram-one-request-before-scale","children":"Diagram: one request before scale"}],"\n",["$","figure","p-3",{"className":"docs_studyFigure__4Js_y","children":[["$","div",null,{"className":"docs_studyFigureViewport__ZYDNN","children":["$","img","img-0",{"className":"docs_studyFigureImage__Gb2YJ","src":"/learning/scale-design/requirements.svg","alt":"An authorized reader passes through the API; metadata and access are checked before the document body is returned.","width":"920","height":"402","loading":"lazy"}]}],["$","figcaption",null,{"children":"An authorized reader passes through the API; metadata and access are checked before the document body is returned."}]]}],"\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33"],false]}]]}],"$L34"]}]
