25:["$","details","pre-0",{"className":"docs_textDiagram__KfHuf","children":[["$","summary",null,{"children":"Read the text version of this flow"}],["$","pre",null,{"children":["$","code","code-0",{"className":"language-aosdf-diagram","children":"Browser ──▶ API ──▶ access + metadata in primary DB\n                └──▶ body in object storage ──▶ authorized response\n"}]}]]}]
26:["$","p","p-4",{"children":"The drawing intentionally omits caches and replicas. Starting here exposes the correctness boundary that every later optimization must preserve. A cache key that ignores user permissions could turn a fast design into a data leak."}]
27:["$","h2","h2-2",{"id":"worked-design-decision","children":"Worked design decision"}]
28:["$","p","p-5",{"children":"Suppose opening a small document takes 130 ms at p99 and the goal is 400 ms. No scaling component is justified yet. Suppose instead search takes 1.8 seconds because it scans every document. Adding API replicas will not change the scan; inspect the query and index first. This is the core system-design habit: find the limiting path, then change that path."}]
29:["$","h2","h2-3",{"id":"implementation-a-credible-first-stack","children":"Implementation: a credible first stack"}]
2a:["$","p","p-6",{"children":"An engineer should be able to build and instrument the smallest version before sketching a fleet. One possible stack is NGINX at ingress, FastAPI for a Python document API, PostgreSQL for metadata and versions, an S3-compatible object store for bodies, and OpenTelemetry for request traces. The API still owns authorization; storage location does not decide who can see a document."}]
2b:["$","table","table-1",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"style":{"textAlign":"center"},"children":"Logo"}],["$","th","th-1",{"children":"Technology and documentation"}],["$","th","th-2",{"children":"Role in this design"}],["$","th","th-3",{"children":"Check before adopting"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-nginx.svg","alt":"nginx logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://nginx.org/en/docs/http/ngx_http_proxy_module.html","target":"_blank","rel":"noopener noreferrer","children":"NGINX"}]}],["$","td","td-2",{"children":"Forward HTTP requests to the API."}],["$","td","td-3",{"children":"Set timeouts and trusted forwarded headers explicitly."}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-fastapi.svg","alt":"fastapi logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://fastapi.tiangolo.com/tutorial/dependencies/","target":"_blank","rel":"noopener noreferrer","children":"FastAPI"}]}],["$","td","td-2",{"children":"Express request handlers and inject an authenticated principal."}],["$","td","td-3",{"children":"Put object authorization in the handler or service, not only a global dependency."}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-postgresql.svg","alt":"postgresql logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://www.postgresql.org/docs/current/","target":"_blank","rel":"noopener noreferrer","children":"PostgreSQL"}]}],["$","td","td-2",{"children":"Keep access, metadata, and version changes in transactions."}],["$","td","td-3",{"children":"Model permission and version constraints before optimizing."}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"style":{"textAlign":"center"},"children":["$","img","img-0",{"className":"docs_techLogo__X80vW","src":"/learning/scale-design/logo-opentelemetry.svg","alt":"opentelemetry logo","width":"32","height":"32","loading":"lazy"}]}],["$","td","td-1",{"children":["$","a","a-0",{"href":"https://opentelemetry.io/docs/concepts/","target":"_blank","rel":"noopener noreferrer","children":"OpenTelemetry"}]}],["$","td","td-2",{"children":"Trace the request across API, database, and object retrieval."}],["$","td","td-3",{"children":"Do not put document content or tokens in spans."}]]}]]}]]}]
2c:["$","p","p-7",{"children":["For the first implementation, define ",["$","code","code-0",{"children":"documents(id, tenant_id, owner_id, version, object_key)"}]," and a FastAPI ",["$","code","code-1",{"children":"GET /documents/{id}"}]," handler. A dependency can resolve the signed-in principal; the handler or document service must then check that principal's tenant and document permission ",["$","strong","strong-0",{"children":"before"}]," fetching the object. Record one span for the permission query and one for object retrieval. A fast response that bypasses the permission check is a correctness failure, regardless of its latency."]}]
