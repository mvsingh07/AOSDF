2b:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":["Recalculate the worked example with learning rate ",["$","code","code-0",{"children":"0.25"}],". What is the new weight and loss?"]}],"\n",["$","li","li-1",{"children":"Draw training and validation loss curves where validation begins to rise. Mark the model version you would consider keeping."}],"\n",["$","li","li-2",{"children":"List the parameters and two hyperparameters for a simple classifier. Explain which are learned from examples."}],"\n"]}]
