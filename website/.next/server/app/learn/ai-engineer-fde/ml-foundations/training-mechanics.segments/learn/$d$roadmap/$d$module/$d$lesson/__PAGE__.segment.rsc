th=device-width, initial-scale=1"}]]}],["$","$L20",null,{"children":[["$","div",null,{"hidden":true,"children":["$","$21",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Loss, parameters, and gradient descent · ML foundations"}],["$","meta","1",{"name":"description","content":"The foundations of an AI-orchestrated software factory: specifications, coordinated agents, and evidence-based validation."}]]}]}],null]}],null]}],"p":"$@22","v":null,"s":"$5"}},"a":"$@23","u":"$@24","b":"NfOsFHPev3WyF2vd53cxj"}
