25:["$","p","p-5",{"children":"The lower path matters operationally: serving should use a known model version. Retraining produces a new candidate; it does not silently alter the model used for every live request."}]
26:["$","p","p-6",{"children":[["$","$L13","a-0",{"href":"/ml-foundations-lifecycle.archify.html","children":"Explore the full ML lifecycle diagram"}]," to see where a trained model enters evaluation and serving."]}]
