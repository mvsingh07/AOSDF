30:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":["$","a","a-0",{"href":"https://developers.google.com/machine-learning/crash-course/linear-regression/gradient-descent","target":"_blank","rel":"noopener noreferrer","children":"Google ML Crash Course: Gradient descent"}]}],"\n",["$","li","li-1",{"children":["$","a","a-0",{"href":"https://developers.google.com/machine-learning/crash-course/overfitting/overfitting","target":"_blank","rel":"noopener noreferrer","children":"Google ML Crash Course: Overfitting"}]}],"\n"]}]
