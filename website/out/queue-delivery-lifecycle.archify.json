  "lanes": [
    { "id": "request", "label": "Request and state" },
    { "id": "delivery", "label": "Delivery path" },
    { "id": "recovery", "label": "Failure and recovery", "variant": "exception" }
  ],
  "mainPath": ["accept", "outbox", "publish", "claim", "effect", "ack"],
  "nodes": [
    { "id": "accept", "lane": "request", "col": 0, "type": "frontend", "label": "Accept", "sublabel": "request ID" },
    { "id": "outbox", "lane": "request", "col": 1, "type": "database", "label": "Commit", "sublabel": "state + outbox" },
    { "id": "publish", "lane": "delivery", "col": 2, "type": "messagebus", "label": "Publish", "sublabel": "durable queue" },
    { "id": "claim", "lane": "delivery", "col": 3, "type": "backend", "label": "Claim", "sublabel": "visibility lease" },
    { "id": "effect", "lane": "delivery", "col": 4, "type": "external", "label": "Apply", "sublabel": "idempotent effect" },
    { "id": "ack", "lane": "delivery", "col": 5, "type": "backend", "label": "Ack", "sublabel": "after success" },
    { "id": "retry", "lane": "recovery", "col": 3, "type": "cloud", "label": "Retry", "sublabel": "backoff + jitter" },
    { "id": "dlq", "lane": "recovery", "col": 4, "type": "messagebus", "label": "Quarantine", "sublabel": "DLQ + inspect" },
