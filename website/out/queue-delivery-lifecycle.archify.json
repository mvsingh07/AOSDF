    { "from": "effect", "to": "ack", "label": "commit result" },
    { "from": "claim", "to": "retry", "label": "transient failure", "role": "error" },
    { "from": "retry", "to": "dlq", "label": "attempt limit", "role": "error" },
    { "from": "dlq", "to": "replay", "label": "fix + review" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Request contract", "items": ["Return an operation ID after durable acceptance", "State and outbox entry commit together"] },
    { "dot": "amber", "title": "Failure contract", "items": ["A lost acknowledgement may redeliver the same job", "The consumer checks the effect before repeating it"] },
    { "dot": "emerald", "title": "Recovery contract", "items": ["Bound attempts and isolate poison messages", "Replay only after inspecting the cause and duplicate risk"] }
  ]
